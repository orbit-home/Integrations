{
  "id": "tapo",
  "name": "TP-Link Tapo",
  "description": "Local control of Tapo plugs and bulbs over the KLAP protocol.",
  "category": "lighting",
  "icon": "lightbulb",
  "version": "1.0.0",
  "configSchema": [
    { "key": "host", "label": "Device IP address", "type": "string", "required": true, "placeholder": "192.168.0.37" },
    { "key": "username", "label": "TP-Link account email", "type": "string", "required": true },
    { "key": "password", "label": "Password", "type": "password", "required": true },
    { "key": "poll_seconds", "label": "Poll interval (seconds)", "type": "number", "default": 10 }
  ],
  "domains": ["light", "switch", "sensor"],
  "supportsDiscovery": false,
  "auth": { "supported": true, "mode": "credentials", "label": "Sign in" }
}
